# Copie para .env.local (ou cadastre na Vercel → Settings → Environment Variables) e faça um novo deploy.

# Google Ads: ID da tag (Google Ads → Metas → Conversões → "Instalar a tag"). Sem ele, nenhuma tag do Google carrega.
NEXT_PUBLIC_GADS_ID=AW-1234567890
# Rótulo da conversão "Entrar no grupo".
NEXT_PUBLIC_GADS_LABEL=AbCdEfGhIjK
# Google Analytics 4 (opcional; configurado na mesma tag do Ads).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
